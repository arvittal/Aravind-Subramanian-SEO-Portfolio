<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600" width="100%" height="100%">
  <defs>
    <!-- Background Slate Gradient -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4B5663"/>
      <stop offset="35%" stop-color="#55606E"/>
      <stop offset="70%" stop-color="#475260"/>
      <stop offset="100%" stop-color="#38424E"/>
    </linearGradient>

    <!-- Slats Shadow & Highlight -->
    <linearGradient id="slatHighlight" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#6F7C8D" stop-opacity="0.6"/>
      <stop offset="15%" stop-color="#55606E" stop-opacity="0.1"/>
      <stop offset="90%" stop-color="#2D353F" stop-opacity="0.5"/>
      <stop offset="100%" stop-color="#1E242C" stop-opacity="0.8"/>
    </linearGradient>

    <!-- Face Skin Tone Gradients -->
    <radialGradient id="skinBase" cx="50%" cy="45%" r="50%">
      <stop offset="0%" stop-color="#CF9D76"/>
      <stop offset="45%" stop-color="#BE8963"/>
      <stop offset="75%" stop-color="#A7724E"/>
      <stop offset="100%" stop-color="#885535"/>
    </radialGradient>

    <radialGradient id="skinCheek" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#D99778" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#BE8963" stop-opacity="0"/>
    </radialGradient>

    <!-- Suit Jacket Gradient -->
    <linearGradient id="jacketGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#A5ACB5"/>
      <stop offset="50%" stop-color="#8C939D"/>
      <stop offset="100%" stop-color="#6E757F"/>
    </linearGradient>

    <!-- Royal Blue Shirt Gradient -->
    <linearGradient id="shirtGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#2979FF"/>
      <stop offset="50%" stop-color="#1E65E0"/>
      <stop offset="100%" stop-color="#104AB3"/>
    </linearGradient>

    <!-- Blue Lens Anti-Reflective Glare -->
    <linearGradient id="blueLensGlare" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.75"/>
      <stop offset="40%" stop-color="#1D4ED8" stop-opacity="0.85"/>
      <stop offset="80%" stop-color="#1E3A8A" stop-opacity="0.7"/>
      <stop offset="100%" stop-color="#60A5FA" stop-opacity="0.4"/>
    </linearGradient>

    <!-- Circular Profile Mask -->
    <clipPath id="circleClip">
      <circle cx="300" cy="300" r="285"/>
    </clipPath>

    <!-- Face Silhouette Clip -->
    <clipPath id="faceClip">
      <ellipse cx="300" cy="275" rx="145" ry="175"/>
    </clipPath>

    <!-- Glasses Lens Clip Left & Right -->
    <clipPath id="leftLensClip">
      <rect x="180" y="210" width="100" height="75" rx="20"/>
    </clipPath>
    <clipPath id="rightLensClip">
      <rect x="320" y="210" width="100" height="75" rx="20"/>
    </clipPath>
  </defs>

  <!-- Outer Dark Background Border ring -->
  <circle cx="300" cy="300" r="295" fill="#0B0D10" stroke="#00E5A0" stroke-width="2" stroke-opacity="0.3"/>

  <!-- Main Clipped Content -->
  <g clip-path="url(#circleClip)">
    
    <!-- 1. Background Slate Architectural Wall -->
    <rect width="600" height="600" fill="url(#bgGrad)"/>
    
    <!-- Horizontal Slats / Architectural Panels -->
    <!-- Slat 1 -->
    <rect y="30" width="600" height="90" fill="url(#slatHighlight)"/>
    <line x1="0" y1="120" x2="600" y2="120" stroke="#222830" stroke-width="3"/>
    <line x1="0" y1="122" x2="600" y2="122" stroke="#7A8797" stroke-width="1" opacity="0.6"/>

    <!-- Slat 2 -->
    <rect y="125" width="600" height="95" fill="url(#slatHighlight)"/>
    <line x1="0" y1="220" x2="600" y2="220" stroke="#222830" stroke-width="3"/>
    <line x1="0" y1="222" x2="600" y2="222" stroke="#7A8797" stroke-width="1" opacity="0.6"/>

    <!-- Slat 3 -->
    <rect y="225" width="600" height="95" fill="url(#slatHighlight)"/>
    <line x1="0" y1="320" x2="600" y2="320" stroke="#222830" stroke-width="3"/>
    <line x1="0" y1="322" x2="600" y2="322" stroke="#7A8797" stroke-width="1" opacity="0.6"/>

    <!-- Slat 4 -->
    <rect y="325" width="600" height="95" fill="url(#slatHighlight)"/>
    <line x1="0" y1="420" x2="600" y2="420" stroke="#222830" stroke-width="3"/>
    <line x1="0" y1="422" x2="600" y2="422" stroke="#7A8797" stroke-width="1" opacity="0.6"/>

    <!-- Slat 5 -->
    <rect y="425" width="600" height="175" fill="url(#slatHighlight)"/>

    <!-- Subtle Ambient Vignette behind head -->
    <radialGradient id="behindHeadGlow" cx="50%" cy="40%" r="40%">
      <stop offset="0%" stop-color="#687585" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#38424E" stop-opacity="0"/>
    </radialGradient>
    <circle cx="300" cy="240" r="230" fill="url(#behindHeadGlow)"/>

    <!-- 2. Hair (Back & Top Outline) -->
    <path d="M155,270 Q145,180 200,120 Q260,80 340,90 Q400,105 435,160 Q455,210 445,270 Q455,220 435,145 Q385,85 300,80 Q215,85 165,150 Z" fill="#14171A"/>
    <ellipse cx="300" cy="140" rx="145" ry="60" fill="#181B1F"/>
    <path d="M170,200 C160,140 220,95 300,90 C380,95 440,140 430,200 C420,130 370,100 300,100 C230,100 180,130 170,200 Z" fill="#22272E"/>

    <!-- 3. Ears -->
    <!-- Left Ear -->
    <path d="M165,240 C145,245 140,290 160,310 C170,320 180,310 180,295 Z" fill="#A87350" stroke="#7D5133" stroke-width="2"/>
    <path d="M158,260 C150,270 152,295 162,300" stroke="#875637" stroke-width="2.5" fill="none"/>

    <!-- Right Ear -->
    <path d="M435,240 C455,245 460,290 440,310 C430,320 420,310 420,295 Z" fill="#A87350" stroke="#7D5133" stroke-width="2"/>
    <path d="M442,260 C450,270 448,295 438,300" stroke="#875637" stroke-width="2.5" fill="none"/>

    <!-- 4. Neck -->
    <path d="M225,310 L225,440 L375,440 L375,310 Z" fill="#935F3E"/>
    <!-- Neck Shadow -->
    <path d="M225,320 Q300,380 375,320 L375,390 Q300,430 225,390 Z" fill="#6E4429" opacity="0.6"/>

    <!-- 5. Head / Face Shape -->
    <path d="M165,220 C160,150 210,120 300,120 C390,120 440,150 435,220 C435,280 430,335 390,375 C350,410 250,410 210,375 C170,335 165,280 165,220 Z" fill="url(#skinBase)"/>

    <!-- Forehead Highlight -->
    <ellipse cx="300" cy="180" rx="75" ry="35" fill="#E0AD87" opacity="0.35"/>

    <!-- Cheeks Soft Tone -->
    <ellipse cx="215" cy="285" rx="35" ry="25" fill="url(#skinCheek)"/>
    <ellipse cx="385" cy="285" rx="35" ry="25" fill="url(#skinCheek)"/>

    <!-- Sacred Red Tilak on Forehead -->
    <g transform="translate(300, 168)">
      <ellipse cx="0" cy="0" rx="3.5" ry="4.5" fill="#B91C1C"/>
      <ellipse cx="0" cy="-0.5" rx="2" ry="2.5" fill="#DC2626"/>
      <!-- Subtle white vibhuti trace -->
      <line x1="-7" y1="2.5" x2="7" y2="2.5" stroke="#FFFFFF" stroke-width="1" stroke-linecap="round" opacity="0.4"/>
    </g>

    <!-- Eyebrows -->
    <path d="M185,200 Q225,185 265,195" stroke="#1A1C20" stroke-width="7" stroke-linecap="round" fill="none"/>
    <path d="M415,200 Q375,185 335,195" stroke="#1A1C20" stroke-width="7" stroke-linecap="round" fill="none"/>

    <!-- Eyes (under glasses) -->
    <!-- Left Eye -->
    <ellipse cx="230" cy="245" rx="24" ry="14" fill="#FFFFFF"/>
    <circle cx="232" cy="245" r="10" fill="#2E1C14"/>
    <circle cx="232" cy="245" r="5" fill="#0C0A09"/>
    <circle cx="234" cy="243" r="2.5" fill="#FFFFFF"/>

    <!-- Right Eye -->
    <ellipse cx="370" cy="245" rx="24" ry="14" fill="#FFFFFF"/>
    <circle cx="368" cy="245" r="10" fill="#2E1C14"/>
    <circle cx="368" cy="245" r="5" fill="#0C0A09"/>
    <circle cx="370" cy="243" r="2.5" fill="#FFFFFF"/>

    <!-- Nose -->
    <path d="M292,205 L290,270 Q280,285 295,290 Q300,292 305,290 Q320,285 310,270 L308,205" fill="#B57F5A" opacity="0.3"/>
    <!-- Nose base & nostrils -->
    <path d="M280,285 Q300,300 320,285" stroke="#7A4B2D" stroke-width="2.5" fill="none"/>
    <ellipse cx="283" cy="285" rx="5" ry="3" fill="#59341C"/>
    <ellipse cx="317" cy="285" rx="5" ry="3" fill="#59341C"/>
    <path d="M293,283 Q300,288 307,283" stroke="#875535" stroke-width="2" fill="none"/>

    <!-- Glasses Frame (Signature Thick Black Designer Eyeglasses) -->
    <!-- Frame Dropshadow -->
    <g opacity="0.35" transform="translate(0, 4)">
      <rect x="175" y="206" width="110" height="84" rx="22" fill="#000000"/>
      <rect x="315" y="206" width="110" height="84" rx="22" fill="#000000"/>
      <rect x="282" y="222" width="36" height="12" rx="4" fill="#000000"/>
    </g>

    <!-- Main Acetate Frame -->
    <rect x="175" y="204" width="110" height="84" rx="22" fill="#13161A" stroke="#252A32" stroke-width="2"/>
    <rect x="315" y="204" width="110" height="84" rx="22" fill="#13161A" stroke="#252A32" stroke-width="2"/>
    <!-- Bridge -->
    <path d="M283,222 Q300,217 317,222 L317,230 Q300,226 283,230 Z" fill="#13161A"/>
    <!-- Temples -->
    <path d="M175,225 L150,230" stroke="#13161A" stroke-width="6" stroke-linecap="round"/>
    <path d="M425,225 L450,230" stroke="#13161A" stroke-width="6" stroke-linecap="round"/>

    <!-- Inside Cutout for Lenses -->
    <rect x="183" y="212" width="94" height="68" rx="16" fill="#1D232A" opacity="0.1"/>
    <rect x="323" y="212" width="94" height="68" rx="16" fill="#1D232A" opacity="0.1"/>

    <!-- Vibrant Electric Blue Anti-Reflective Lens Glare -->
    <!-- Left Lens Blue Coating Reflection -->
    <g clip-path="url(#leftLensClip)">
      <rect x="180" y="210" width="100" height="75" fill="url(#blueLensGlare)"/>
      <!-- Soft reflection highlight bars across lens -->
      <polygon points="190,210 240,210 215,285 165,285" fill="#60A5FA" opacity="0.35"/>
      <polygon points="245,210 275,210 250,285 220,285" fill="#93C5FD" opacity="0.25"/>
    </g>

    <!-- Right Lens Blue Coating Reflection -->
    <g clip-path="url(#rightLensClip)">
      <rect x="320" y="210" width="100" height="75" fill="url(#blueLensGlare)"/>
      <!-- Soft reflection highlight bars across lens -->
      <polygon points="330,210 380,210 355,285 305,285" fill="#60A5FA" opacity="0.35"/>
      <polygon points="385,210 415,210 390,285 360,285" fill="#93C5FD" opacity="0.25"/>
    </g>

    <!-- Frame Rim Highlights -->
    <path d="M185,206 L275,206" stroke="#4B5563" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>
    <path d="M325,206 L415,206" stroke="#4B5563" stroke-width="1.5" stroke-linecap="round" opacity="0.7"/>

    <!-- 6. Smile & Cheerful Expression -->
    <!-- Cheerful Smile Lips -->
    <path d="M255,340 Q300,372 345,340 Q300,358 255,340 Z" fill="#9E5959"/>
    <!-- Subtle teeth gleam -->
    <path d="M268,343 Q300,352 332,343" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" opacity="0.85"/>
    <path d="M250,338 Q300,378 350,338" stroke="#683434" stroke-width="2" fill="none"/>
    <!-- Smile Dimples / Creases -->
    <path d="M235,315 Q245,335 252,345" stroke="#875535" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.5"/>
    <path d="M365,315 Q355,335 348,345" stroke="#875535" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.5"/>

    <!-- 7. Signature Mustache (Curling gently over lips) -->
    <!-- Mustache Base & Wings -->
    <path d="M300,314 C285,310 250,310 220,335 C230,345 255,345 275,335 C288,328 296,326 300,326 C304,326 312,328 325,335 C345,345 370,345 380,335 C350,310 315,310 300,314 Z" fill="#14171A"/>
    <!-- Mustache Texture Strands -->
    <path d="M230,333 Q260,330 295,318" stroke="#252A30" stroke-width="1.5" fill="none"/>
    <path d="M370,333 Q340,330 305,318" stroke="#252A30" stroke-width="1.5" fill="none"/>

    <!-- 8. Goatee / Chin Beard -->
    <!-- Soul patch under lower lip -->
    <path d="M288,358 L312,358 L307,370 L293,370 Z" fill="#1A1D22"/>
    <!-- Neatly Groomed Beard on Chin & Jawline -->
    <path d="M245,370 C270,395 330,395 355,370 C360,395 340,418 300,420 C260,418 240,395 245,370 Z" fill="#15181C"/>
    <!-- Jawline Stubble Tracing to ears -->
    <path d="M175,290 C185,350 220,390 255,405" stroke="#181B20" stroke-width="6" stroke-linecap="round" fill="none" opacity="0.75"/>
    <path d="M425,290 C415,350 380,390 345,405" stroke="#181B20" stroke-width="6" stroke-linecap="round" fill="none" opacity="0.75"/>

    <!-- 9. Royal Blue Collared Shirt -->
    <g>
      <!-- Shirt Body Chest -->
      <path d="M210,430 L390,430 L400,600 L200,600 Z" fill="url(#shirtGrad)"/>

      <!-- Shirt Placket Center Strip -->
      <rect x="288" y="470" width="24" height="130" fill="#1651B8"/>
      <!-- Button 1 on Placket -->
      <circle cx="300" cy="515" r="4.5" fill="#E2E8F0" stroke="#94A3B8" stroke-width="1.5"/>
      <circle cx="300" cy="515" r="1.5" fill="#64748B"/>
      <!-- Button 2 on Placket -->
      <circle cx="300" cy="575" r="4.5" fill="#E2E8F0" stroke="#94A3B8" stroke-width="1.5"/>
      <circle cx="300" cy="575" r="1.5" fill="#64748B"/>

      <!-- Left Collar -->
      <path d="M225,430 L295,490 L260,498 L205,445 Z" fill="#2563EB" stroke="#1D4ED8" stroke-width="2"/>
      <!-- Right Collar -->
      <path d="M375,430 L305,490 L340,498 L395,445 Z" fill="#2563EB" stroke="#1D4ED8" stroke-width="2"/>
      
      <!-- Inner Neckline Shadow -->
      <polygon points="280,440 320,440 300,480" fill="#0F3580"/>
    </g>

    <!-- 10. Light Grey Heather / Check Blazer Suit Jacket -->
    <g>
      <!-- Left Shoulder / Chest -->
      <path d="M60,600 C70,520 110,470 190,445 L265,560 L245,600 Z" fill="url(#jacketGrad)"/>
      <!-- Left Lapel -->
      <path d="M190,445 L265,560 L220,575 L165,490 Z" fill="#848B96" stroke="#5E6570" stroke-width="1.5"/>

      <!-- Right Shoulder / Chest -->
      <path d="M540,600 C530,520 490,470 410,445 L335,560 L355,600 Z" fill="url(#jacketGrad)"/>
      <!-- Right Lapel -->
      <path d="M410,445 L335,560 L380,575 L435,490 Z" fill="#848B96" stroke="#5E6570" stroke-width="1.5"/>

      <!-- Lapel Notch Details -->
      <path d="M198,460 L185,475 L200,480" stroke="#4A515C" stroke-width="2" fill="none"/>
      <path d="M402,460 L415,475 L400,480" stroke="#4A515C" stroke-width="2" fill="none"/>

      <!-- Subtle Heather / Micro-check Texture on Jacket -->
      <g opacity="0.15" stroke="#FFFFFF" stroke-width="1" stroke-dasharray="2,3">
        <line x1="100" y1="460" x2="250" y2="600"/>
        <line x1="130" y1="450" x2="270" y2="590"/>
        <line x1="160" y1="445" x2="280" y2="560"/>
        <line x1="500" y1="460" x2="350" y2="600"/>
        <line x1="470" y1="450" x2="330" y2="590"/>
        <line x1="440" y1="445" x2="320" y2="560"/>
      </g>
    </g>

  </g>

  <!-- Polished Circular Frame Border -->
  <circle cx="300" cy="300" r="285" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-opacity="0.2"/>
  <circle cx="300" cy="300" r="288" fill="none" stroke="#00E5A0" stroke-width="1.5" stroke-opacity="0.4"/>
</svg>
